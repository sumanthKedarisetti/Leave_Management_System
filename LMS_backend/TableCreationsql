/* -----------------------------------------------------------------------------
   LeaveRequest

   Status lifecycle:  Pending -> Approved -> Cancelled
                      Pending -> Rejected
                      Pending -> Cancelled   (withdrawn before a decision)

   Hours is always POSITIVE here. The sign lives in LeaveTransaction.
   LeaveYear added: a request spanning 29 Dec to 3 Jan must state which year's
   balance it draws from, and your pending calculation filters on it.
   ----------------------------------------------------------------------------- */
CREATE TABLE dbo.LeaveRequest
(
    RequestId       INT             IDENTITY(1,1)   NOT NULL,
    EmployeeId      INT                             NOT NULL,
    LeaveTypeId     INT                             NOT NULL,
    LeaveYear       SMALLINT                        NOT NULL,
    StartDate       DATE                            NOT NULL,
    EndDate         DATE                            NOT NULL,
    Hours           DECIMAL(6,2)                    NOT NULL,
    Reason          NVARCHAR(1000)                      NULL,
    Status          NVARCHAR(20)                    NOT NULL CONSTRAINT DF_LeaveRequest_Status DEFAULT ('Pending'),

    SubmittedOn     DATETIME2(0)                    NOT NULL CONSTRAINT DF_LeaveRequest_SubmittedOn DEFAULT (SYSUTCDATETIME()),
    SubmittedById   INT                             NOT NULL,   -- usually the employee, but HR can submit for them

    DecisionDate    DATETIME2(0)                        NULL,
    DecidedById     INT                                 NULL,
    DecisionComment NVARCHAR(1000)                      NULL,   -- rejection reason lives here

    CancelledOn     DATETIME2(0)                        NULL,
    CancelledById   INT                                 NULL,

    CONSTRAINT PK_LeaveRequest              PRIMARY KEY CLUSTERED (RequestId),
    CONSTRAINT CK_LeaveRequest_Status       CHECK (Status IN ('Pending','Approved','Rejected','Cancelled')),
    CONSTRAINT CK_LeaveRequest_Dates        CHECK (EndDate >= StartDate),
    CONSTRAINT CK_LeaveRequest_Hours        CHECK (Hours > 0),

    -- A decided request must record who decided and when. A pending one must not.
    CONSTRAINT CK_LeaveRequest_Decision     CHECK (
        (Status IN ('Approved','Rejected') AND DecisionDate IS NOT NULL AND DecidedById IS NOT NULL)
     OR (Status NOT IN ('Approved','Rejected'))
    ),

    -- A rejection must say why.
    CONSTRAINT CK_LeaveRequest_RejectReason CHECK (Status <> 'Rejected' OR DecisionComment IS NOT NULL),

    -- A cancelled request must record who cancelled and when.
    CONSTRAINT CK_LeaveRequest_Cancel       CHECK (
        (Status = 'Cancelled' AND CancelledOn IS NOT NULL AND CancelledById IS NOT NULL)
     OR (Status <> 'Cancelled' AND CancelledOn IS NULL AND CancelledById IS NULL)
    )
);
GO


/* -----------------------------------------------------------------------------
   LeaveTransaction  - THE LEDGER

   Append-only. Never UPDATE or DELETE a row here. To correct a mistake, insert
   an opposing row. Balance = SUM(Hours).

   Hours is SIGNED:
     positive -> ALLOCATION, ACCRUAL, CARRY_FORWARD, REVERSAL, (some ADJUSTMENT)
     negative -> DEDUCTION, EXPIRY, (some ADJUSTMENT)

   EffectiveStart / EffectiveEnd define the window in which the hours are valid.
   An annual allocation runs 01 Jan to 31 Dec. Carry-forward might run 01 Jan to
   31 Mar, which makes expiry automatic rather than special-cased. Both are NULL
   for deductions, which simply consume whatever is available.
   ----------------------------------------------------------------------------- */
CREATE TABLE dbo.LeaveTransaction
(
    TransactionId   INT             IDENTITY(1,1)   NOT NULL,
    EmployeeId      INT                             NOT NULL,
    LeaveTypeId     INT                             NOT NULL,
    LeaveYear       SMALLINT                        NOT NULL,
    TransactionType NVARCHAR(20)                    NOT NULL,
    Hours           DECIMAL(6,2)                    NOT NULL,   -- signed
    LeaveRequestId  INT                                 NULL,   -- set on DEDUCTION and REVERSAL
    Reason          NVARCHAR(1000)                      NULL,   -- free text, required for ADJUSTMENT
    TransactionDate DATETIME2(0)                    NOT NULL CONSTRAINT DF_LeaveTxn_TxnDate  DEFAULT (SYSUTCDATETIME()),
    EffectiveStart  DATE                                NULL,
    EffectiveEnd    DATE                                NULL,
    CreatedOn       DATETIME2(0)                    NOT NULL CONSTRAINT DF_LeaveTxn_CreatedOn DEFAULT (SYSUTCDATETIME()),
    CreatedById     INT                                 NULL,   -- NULL for rows written by the allocation job

    CONSTRAINT PK_LeaveTransaction      PRIMARY KEY CLUSTERED (TransactionId),

    CONSTRAINT CK_LeaveTxn_Type         CHECK (TransactionType IN
        ('ALLOCATION','ACCRUAL','CARRY_FORWARD','DEDUCTION','REVERSAL','ADJUSTMENT','EXPIRY')),

    -- A zero-hour transaction is meaningless and usually a bug.
    CONSTRAINT CK_LeaveTxn_NonZero      CHECK (Hours <> 0),

    -- Direction must match the type. This catches a deduction written as +8.
    CONSTRAINT CK_LeaveTxn_Sign         CHECK (
        (TransactionType IN ('ALLOCATION','ACCRUAL','CARRY_FORWARD','REVERSAL') AND Hours > 0)
     OR (TransactionType IN ('DEDUCTION','EXPIRY')                              AND Hours < 0)
     OR (TransactionType = 'ADJUSTMENT')   -- may go either way
    ),

    -- A manual adjustment with no explanation is an audit trail that cannot answer anything.
    CONSTRAINT CK_LeaveTxn_AdjReason    CHECK (TransactionType <> 'ADJUSTMENT' OR Reason IS NOT NULL),

    -- Deductions and reversals must point at the request that caused them.
    CONSTRAINT CK_LeaveTxn_RequestLink  CHECK (
        (TransactionType IN ('DEDUCTION','REVERSAL') AND LeaveRequestId IS NOT NULL)
     OR (TransactionType NOT IN ('DEDUCTION','REVERSAL'))
    ),

    CONSTRAINT CK_LeaveTxn_EffDates     CHECK (EffectiveEnd IS NULL OR EffectiveStart IS NULL OR EffectiveEnd >= EffectiveStart)
);
GO


/* =============================================================================
   SECTION 3 - FOREIGN KEYS

   Every one is NO ACTION (the SQL Server default) rather than CASCADE.

   This is not caution for its own sake. Employee.ManagerId, CreatedById and
   ModifiedById all point back at Employee, and LeaveRequest is reachable from
   Employee by several paths. Cascade on any of these produces either
   "may cause cycles or multiple cascade paths" at create time, or a delete that
   silently removes somebody's entire leave history. Deactivate with IsActive
   instead of deleting.
   ============================================================================= */

ALTER TABLE dbo.Department ADD
    CONSTRAINT FK_Department_CreatedBy  FOREIGN KEY (CreatedById)  REFERENCES dbo.Employee (EmployeeId),
    CONSTRAINT FK_Department_ModifiedBy FOREIGN KEY (ModifiedById) REFERENCES dbo.Employee (EmployeeId);
GO

ALTER TABLE dbo.Employee ADD
    CONSTRAINT FK_Employee_Department   FOREIGN KEY (DepartmentId) REFERENCES dbo.Department (DepartmentId),
    CONSTRAINT FK_Employee_Manager      FOREIGN KEY (ManagerId)    REFERENCES dbo.Employee (EmployeeId),
    CONSTRAINT FK_Employee_CreatedBy    FOREIGN KEY (CreatedById)  REFERENCES dbo.Employee (EmployeeId),
    CONSTRAINT FK_Employee_ModifiedBy   FOREIGN KEY (ModifiedById) REFERENCES dbo.Employee (EmployeeId);
GO

ALTER TABLE dbo.AppUser ADD
    CONSTRAINT FK_AppUser_Employee      FOREIGN KEY (EmployeeId) REFERENCES dbo.Employee (EmployeeId);
GO

ALTER TABLE dbo.UserRole ADD
    CONSTRAINT FK_UserRole_User         FOREIGN KEY (UserId) REFERENCES dbo.AppUser (UserId),
    CONSTRAINT FK_UserRole_Role         FOREIGN KEY (RoleId) REFERENCES dbo.Role (RoleId);
GO

ALTER TABLE dbo.LeaveRequest ADD
    CONSTRAINT FK_LeaveRequest_Employee    FOREIGN KEY (EmployeeId)    REFERENCES dbo.Employee (EmployeeId),
    CONSTRAINT FK_LeaveRequest_LeaveType   FOREIGN KEY (LeaveTypeId)   REFERENCES dbo.LeaveType (LeaveTypeId),
    CONSTRAINT FK_LeaveRequest_SubmittedBy FOREIGN KEY (SubmittedById) REFERENCES dbo.Employee (EmployeeId),
    CONSTRAINT FK_LeaveRequest_DecidedBy   FOREIGN KEY (DecidedById)   REFERENCES dbo.Employee (EmployeeId),
    CONSTRAINT FK_LeaveRequest_CancelledBy FOREIGN KEY (CancelledById) REFERENCES dbo.Employee (EmployeeId);
GO

ALTER TABLE dbo.LeaveTransaction ADD
    CONSTRAINT FK_LeaveTxn_Employee     FOREIGN KEY (EmployeeId)     REFERENCES dbo.Employee (EmployeeId),
    CONSTRAINT FK_LeaveTxn_LeaveType    FOREIGN KEY (LeaveTypeId)    REFERENCES dbo.LeaveType (LeaveTypeId),
    CONSTRAINT FK_LeaveTxn_LeaveRequest FOREIGN KEY (LeaveRequestId) REFERENCES dbo.LeaveRequest (RequestId),
    CONSTRAINT FK_LeaveTxn_CreatedBy    FOREIGN KEY (CreatedById)    REFERENCES dbo.Employee (EmployeeId);
GO


/* =============================================================================
   SECTION 4 - INDEXES
   ============================================================================= */

/* THE IMPORTANT ONE.
   Stops the yearly allocation job creating a second allocation if it runs twice.
   Filtered, because deductions obviously repeat - only the once-per-year rows
   are constrained. Without this, a re-run silently doubles everyone's leave. */
CREATE UNIQUE NONCLUSTERED INDEX UX_LeaveTxn_OneGrantPerYear
    ON dbo.LeaveTransaction (EmployeeId, LeaveTypeId, LeaveYear, TransactionType)
    WHERE TransactionType IN ('ALLOCATION','CARRY_FORWARD');
GO

/* Covers the balance query: SUM(Hours) for one employee / type / year. */
CREATE NONCLUSTERED INDEX IX_LeaveTxn_Balance
    ON dbo.LeaveTransaction (EmployeeId, LeaveTypeId, LeaveYear)
    INCLUDE (Hours, TransactionType, EffectiveEnd);
GO

/* Covers the pending-hours query. */
CREATE NONCLUSTERED INDEX IX_LeaveRequest_Pending
    ON dbo.LeaveRequest (EmployeeId, LeaveTypeId, LeaveYear, Status)
    INCLUDE (Hours);
GO

/* "Show me requests waiting for my decision" - the manager's inbox. */
CREATE NONCLUSTERED INDEX IX_LeaveRequest_Status_Dates
    ON dbo.LeaveRequest (Status, StartDate)
    INCLUDE (EmployeeId, LeaveTypeId, Hours);
GO

/* "Who is off next Tuesday" - overlapping date range scan. */
CREATE NONCLUSTERED INDEX IX_LeaveRequest_DateRange
    ON dbo.LeaveRequest (StartDate, EndDate)
    INCLUDE (EmployeeId, Status);
GO

CREATE NONCLUSTERED INDEX IX_Employee_Manager    ON dbo.Employee (ManagerId);
CREATE NONCLUSTERED INDEX IX_Employee_Department ON dbo.Employee (DepartmentId);
GO


/* =============================================================================
   SECTION 5 - BALANCE VIEW

   This replaces the EmployeeLeaveBalance table. It is calculated, so it can
   never disagree with the transactions behind it.

   AvailableHours already subtracts pending requests, so it is the number to
   show an employee and to validate a new request against. Without that
   subtraction someone with 8 hours left could submit two 8-hour requests while
   the first is still awaiting approval.
   ============================================================================= */
GO
CREATE VIEW dbo.vw_EmployeeLeaveBalance
AS
SELECT
    e.EmployeeId,
    lt.LeaveTypeId,
    t.LeaveYear,

    -- Everything granted: allocation, accrual, carry-forward, positive adjustments
    SUM(CASE WHEN t.Hours > 0 THEN t.Hours ELSE 0 END)           AS GrantedHours,

    -- Everything consumed, as a positive number for display
    SUM(CASE WHEN t.Hours < 0 THEN -t.Hours ELSE 0 END)          AS UsedHours,

    -- The ledger balance
    SUM(t.Hours)                                                 AS RemainingHours,

    -- Submitted but not yet decided
    ISNULL((
        SELECT SUM(r.Hours)
        FROM dbo.LeaveRequest r
        WHERE r.EmployeeId  = e.EmployeeId
          AND r.LeaveTypeId = lt.LeaveTypeId
          AND r.LeaveYear   = t.LeaveYear
          AND r.Status      = 'Pending'
    ), 0)                                                        AS PendingHours,

    -- What the employee can actually book right now
    SUM(t.Hours) - ISNULL((
        SELECT SUM(r.Hours)
        FROM dbo.LeaveRequest r
        WHERE r.EmployeeId  = e.EmployeeId
          AND r.LeaveTypeId = lt.LeaveTypeId
          AND r.LeaveYear   = t.LeaveYear
          AND r.Status      = 'Pending'
    ), 0)                                                        AS AvailableHours

FROM dbo.LeaveTransaction t
JOIN dbo.Employee  e  ON e.EmployeeId  = t.EmployeeId
JOIN dbo.LeaveType lt ON lt.LeaveTypeId = t.LeaveTypeId
GROUP BY e.EmployeeId, lt.LeaveTypeId, t.LeaveYear;
GO


