/* -----------------------------------------------------------------------------
   Department
   CreatedById / ModifiedById are NULLABLE on purpose. Department references
   Employee and Employee references Department, so the very first department you
   insert has no employee to credit yet. Nullable breaks that deadlock.
   ----------------------------------------------------------------------------- */
CREATE TABLE dbo.Department
(
    DepartmentId    INT             IDENTITY(1,1)   NOT NULL,
    Name            NVARCHAR(100)                   NOT NULL,
    Description     NVARCHAR(500)                       NULL,
    IsActive        BIT                             NOT NULL CONSTRAINT DF_Department_IsActive  DEFAULT (1),
    CreatedOn       DATETIME2(0)                    NOT NULL CONSTRAINT DF_Department_CreatedOn DEFAULT (SYSUTCDATETIME()),
    CreatedById     INT                                 NULL,
    ModifiedOn      DATETIME2(0)                        NULL,
    ModifiedById    INT                                 NULL,

    CONSTRAINT PK_Department        PRIMARY KEY CLUSTERED (DepartmentId),
    CONSTRAINT UQ_Department_Name   UNIQUE (Name)
);
GO


/* -----------------------------------------------------------------------------
   Employee
   TerminationDate added: IsActive tells you someone left, but not when, which
   you need for pro-rating a final entitlement.
   ----------------------------------------------------------------------------- */
CREATE TABLE dbo.Employee
(
    EmployeeId      INT             IDENTITY(1,1)   NOT NULL,
    EmployeeNumber  NVARCHAR(20)                    NOT NULL,
    FirstName       NVARCHAR(100)                   NOT NULL,
    LastName        NVARCHAR(100)                   NOT NULL,
    Email           NVARCHAR(256)                   NOT NULL,
    ManagerId       INT                                 NULL,   -- self-reference; NULL for the top of the tree
    DepartmentId    INT                             NOT NULL,
    HireDate        DATE                            NOT NULL,
    TerminationDate DATE                                NULL,
    IsActive        BIT                             NOT NULL CONSTRAINT DF_Employee_IsActive  DEFAULT (1),
    CreatedOn       DATETIME2(0)                    NOT NULL CONSTRAINT DF_Employee_CreatedOn DEFAULT (SYSUTCDATETIME()),
    CreatedById     INT                                 NULL,
    ModifiedOn      DATETIME2(0)                        NULL,
    ModifiedById    INT                                 NULL,

    CONSTRAINT PK_Employee              PRIMARY KEY CLUSTERED (EmployeeId),
    CONSTRAINT UQ_Employee_Number       UNIQUE (EmployeeNumber),
    CONSTRAINT UQ_Employee_Email        UNIQUE (Email),
    CONSTRAINT CK_Employee_NotOwnManager CHECK (ManagerId IS NULL OR ManagerId <> EmployeeId),
    CONSTRAINT CK_Employee_TermAfterHire CHECK (TerminationDate IS NULL OR TerminationDate >= HireDate)
);
GO


/* -----------------------------------------------------------------------------
   LeaveType
   DefaultAnnualHours is the CURRENT policy value. It is copied onto each
   allocation transaction when leave is granted, so changing it next year does
   not silently rewrite what people were given this year.
   ----------------------------------------------------------------------------- */
CREATE TABLE dbo.LeaveType
(
    LeaveTypeId         INT             IDENTITY(1,1)   NOT NULL,
    Code                NVARCHAR(20)                    NOT NULL,   -- ANNUAL, SICK, CASUAL...
    TypeName            NVARCHAR(100)                   NOT NULL,
    Description         NVARCHAR(500)                       NULL,
    DefaultAnnualHours  DECIMAL(6,2)                    NOT NULL CONSTRAINT DF_LeaveType_Hours    DEFAULT (0),
    IsActive            BIT                             NOT NULL CONSTRAINT DF_LeaveType_IsActive DEFAULT (1),
    CreatedOn           DATETIME2(0)                    NOT NULL CONSTRAINT DF_LeaveType_CreatedOn DEFAULT (SYSUTCDATETIME()),
    ModifiedOn          DATETIME2(0)                        NULL,

    CONSTRAINT PK_LeaveType         PRIMARY KEY CLUSTERED (LeaveTypeId),
    CONSTRAINT UQ_LeaveType_Code    UNIQUE (Code),
    CONSTRAINT UQ_LeaveType_Name    UNIQUE (TypeName),
    CONSTRAINT CK_LeaveType_Hours   CHECK (DefaultAnnualHours >= 0)
);
GO


/* -----------------------------------------------------------------------------
   AppUser  (your "user" table)
   Renamed because USER is a reserved word in SQL Server. Using it means writing
   [User] in brackets forever and fighting EF Core over the mapping.

   EmployeeId is UNIQUE: one login per employee.
   PasswordHash is nullable so SSO-only accounts (ExternalProviderId set) work.
   ----------------------------------------------------------------------------- */
CREATE TABLE dbo.AppUser
(
    UserId              INT             IDENTITY(1,1)   NOT NULL,
    EmployeeId          INT                             NOT NULL,
    UserName            NVARCHAR(100)                   NOT NULL,
    PasswordHash        NVARCHAR(500)                       NULL,
    ExternalProviderId  NVARCHAR(200)                       NULL,
    IsActive            BIT                             NOT NULL CONSTRAINT DF_AppUser_IsActive  DEFAULT (1),
    LastLoginDate       DATETIME2(0)                        NULL,
    CreatedOn           DATETIME2(0)                    NOT NULL CONSTRAINT DF_AppUser_CreatedOn DEFAULT (SYSUTCDATETIME()),
    ModifiedOn          DATETIME2(0)                        NULL,

    CONSTRAINT PK_AppUser               PRIMARY KEY CLUSTERED (UserId),
    CONSTRAINT UQ_AppUser_UserName      UNIQUE (UserName),
    CONSTRAINT UQ_AppUser_EmployeeId    UNIQUE (EmployeeId),
    CONSTRAINT CK_AppUser_HasCredential CHECK (PasswordHash IS NOT NULL OR ExternalProviderId IS NOT NULL)
